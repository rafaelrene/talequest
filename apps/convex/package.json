    "test": "vitest run",
    "codegen": "convex codegen"
  },
  "dependencies": {
    "@talequest/content": "workspace:*",
    "convex": "^1.28.4",
    "effect": "^3.18.4",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.4.0"
  }
}
